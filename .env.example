# Copy this file to .env and fill in values locally.
# Never commit .env or paste secrets into chat.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite (default, quick local) or postgres
DATABASE_URL=sqlite

# PostgreSQL (used when DATABASE_URL=postgres)
POSTGRES_DB=stalking
POSTGRES_USER=stalking
POSTGRES_PASSWORD=stalking_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Gemini — leave empty to run the site without AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_INPUT_CHARS=2000
GEMINI_RATE_LIMIT_PER_MINUTE=8

# Security (set True only behind HTTPS in production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Anonymous Help Request & Email Configuration
# If HELP_REQUEST_EMAIL is empty, the feature is safely disabled
HELP_REQUEST_EMAIL=specialist@example.com
# Resend Email API (Recommended for Render: 3000 emails/month free via HTTPS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Stalking-AI <onboarding@resend.dev>
# Optional: Web3Forms Access Key
WEB3FORMS_ACCESS_KEY=
HELP_REQUEST_RATE_LIMIT=5

# SMTP / Email Service (use console.EmailBackend for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@stalking.kz
EMAIL_TIMEOUT=15
